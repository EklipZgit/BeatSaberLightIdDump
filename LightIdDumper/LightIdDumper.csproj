<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Match ChromaGLS's target and complete supported-version configuration matrix. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Configurations>Debug-1.29.1;Release-1.29.1;Debug-1.34.2;Release-1.34.2;Debug-1.37.1;Release-1.37.1;Debug-1.40.8;Release-1.40.8;Debug-1.42.1;Release-1.42.1;Debug-1.44.1;Release-1.44.1;Debug-1.44.2;Release-1.44.2</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!-- Retain the source project's version symbols so future per-version patches can use the same boundaries. -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug-1.29.1' Or '$(Configuration)'=='Release-1.29.1'">
    <DefineConstants>V1_29_1;PRE_V1_37_1</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug-1.34.2' Or '$(Configuration)'=='Release-1.34.2'">
    <DefineConstants>PRE_V1_37_1</DefineConstants>
  </PropertyGroup>

  <!-- Give the diagnostic mod an independent BSIPA identity and release number. -->
  <PropertyGroup>
    <PluginId>LightIdDumper</PluginId>
    <PluginName>LightIdDumper</PluginName>
    <Author>EklipZ</Author>
    <Authors>EklipZ</Authors>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Description>Dumps each environment's runtime LightWithIdManager registration table, Chroma-compatible object paths, component types, and transforms for cross-version light ID remapping.</Description>
  </PropertyGroup>

  <!-- The dumper uses no Chroma, SongCore, or CustomJSONData API, so BSIPA is its only runtime prerequisite. -->
  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.2.2" />
  </ItemGroup>

  <!-- Game and loader references are compile-time only; publicizing exposes the authoritative light array. -->
  <ItemDefinitionGroup>
    <Reference Private="False" />
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Prefer the selected BSIPA install's HarmonyX; 1.44.2 can restore the matching compile-only package when its local BSIPA payload is incomplete. -->
    <Reference Include="0Harmony" Condition="Exists('$(BeatSaberDir)\Libs\0Harmony.dll')" HintPath="$(BeatSaberDir)\Libs\0Harmony.dll" />
    <!-- Beat Saber 1.34.2 moved PersistentScriptableObject from HMLib into BGLib.UnityExtension, so legacy environment asset inheritance compiles against whichever base assembly the selected game ships. -->
    <Reference Include="BGLib.UnityExtension" Condition="Exists('$(BeatSaberDir)\Beat Saber_Data\Managed\BGLib.UnityExtension.dll')" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\BGLib.UnityExtension.dll" />
    <!-- The legacy native environment patch returns EnvironmentInfoSO, whose PersistentScriptableObject base is declared in HMLib. -->
    <Reference Include="HMLib" Condition="Exists('$(BeatSaberDir)\Beat Saber_Data\Managed\HMLib.dll')" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\HMLib.dll" />
    <Reference Include="HMRendering" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\HMRendering.dll" Publicize="true" />
    <Reference Include="IPA.Loader" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\IPA.Loader.dll" />
    <Reference Include="Main" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\Main.dll" Publicize="true" />
    <!-- Modern environment selection types moved to DataModels.dll, so only configurations that ship it compile the native difficulty-environment patch against it. -->
    <Reference Include="DataModels" Condition="Exists('$(BeatSaberDir)\Beat Saber_Data\Managed\DataModels.dll')" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\DataModels.dll" Publicize="true" />
    <!-- Beat Saber 1.44.2 ships Newtonsoft.Json as a managed game assembly rather than below the BSIPA Libs directory. -->
    <Reference Include="Newtonsoft.Json" Condition="Exists('$(BeatSaberDir)\Libs\Newtonsoft.Json.dll')" HintPath="$(BeatSaberDir)\Libs\Newtonsoft.Json.dll" />
    <Reference Include="Newtonsoft.Json" Condition="!Exists('$(BeatSaberDir)\Libs\Newtonsoft.Json.dll')" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\Newtonsoft.Json.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll" />
    <!-- EnvironmentSceneSetup derives from MonoInstaller, so its base assembly is required even though no Zenject API is called directly. -->
    <Reference Include="Zenject" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\Zenject.dll" />
  </ItemGroup>

  <!-- Keep the same authenticated Luna build/deploy pipeline and analyzer version as ChromaGLS. -->
  <ItemGroup>
    <!-- HarmonyX 2.16.0 matches BSIPA 4.3.7's runtime assembly and is compile-only when the selected install cannot provide its own reference. -->
    <PackageReference Include="HarmonyX" Version="2.16.0" Condition="!Exists('$(BeatSaberDir)\Libs\0Harmony.dll')" PrivateAssets="all" />
    <PackageReference Include="BeatSaberModdingTools.Tasks.Luna" Version="2.1.0" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.*" />
    <PackageReference Include="LunaBSMod.Tasks" Version="1.1.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.354" />
  </ItemGroup>
</Project>
