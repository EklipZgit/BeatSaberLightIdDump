<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The cloned Luna build tasks are hosted on Aeroluna's authenticated package feed. -->
  <packageSources>
    <clear />
    <add key="Aeroluna Github Packages" value="https://nuget.pkg.github.com/Aeroluna/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
